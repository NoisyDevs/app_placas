# Plantilla para apuntar el backend al proyecto Supabase hosteado.
# Copiala a `backend/.env` (ya está en .gitignore) y completá los valores.
# NUNCA commitees valores reales en este archivo.

ENVIRONMENT=production

# Proyecto hosteado
SUPABASE_URL=https://kqctrpapevhlukcnnnzw.supabase.co

# Dashboard -> Settings -> API Keys -> service_role (secreta, solo backend)
SUPABASE_SERVICE_ROLE_KEY=

# Solo si el proyecto usa JWT legacy HS256. Los proyectos nuevos publican JWKS
# y esto se puede dejar vacío (ver app/deps.py).
