# Mercado Pago: dejar los placeholders de dev hasta tener credenciales reales.
MERCADOPAGO_ACCESS_TOKEN=TEST-local-dev-token
MERCADOPAGO_WEBHOOK_SECRET=local-dev-webhook-secret
